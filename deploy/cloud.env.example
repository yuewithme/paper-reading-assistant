# Copy to .env.cloud on the server. Never commit the real file.
APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8000
FRONTEND_ORIGIN=http://YOUR_SERVER_IP:28473

DASHSCOPE_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_TRANSLATION_MODEL=qwen-mt-flash
QWEN_ANALYSIS_MODEL=qwen3.7-max
QWEN_CHAT_MODEL=qwen3.7-max
QWEN_TRANSLATION_WORKERS=3
QWEN_ANALYSIS_WORKERS=3
QWEN_TRANSLATION_RPM=55
QWEN_MAX_RETRIES=5

OCR_DEVICE=cpu
PADDLE_PDX_MODEL_SOURCE=BOS
OCR_CPU_THREADS=4
OCR_ENABLE_HPI=false
OCR_LAYOUT_MODEL=PP-DocLayout-M
OCR_TEXT_DETECTION_MODEL=PP-OCRv5_mobile_det
OCR_TEXT_RECOGNITION_MODEL=en_PP-OCRv4_mobile_rec
OCR_FORMULA_MODEL=PP-FormulaNet-S
OCR_TABLE_STRUCTURE_MODEL=SLANet_plus
OCR_USE_REGION_DETECTION=false
AUTO_TRANSLATE=true
AUTO_ANALYZE=true

DATABASE_URL=sqlite:////app/data/paper_reader.db
STORAGE_PATH=/app/data/papers
MAX_PDF_SIZE_MB=100

PAPER_READER_PORT=28473
PAPER_READER_BACKEND_PORT=18100
