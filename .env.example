# Copy this file to .env and fill in your own values.
# Never commit the real .env file.

APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
FRONTEND_ORIGIN=http://localhost:5173

# Qwen / Alibaba Cloud Model Studio
# Beijing OpenAI-compatible endpoint. Replace it if your API key belongs to
# another region or a workspace-specific endpoint.
DASHSCOPE_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_TRANSLATION_MODEL=qwen-mt-flash
QWEN_ANALYSIS_MODEL=qwen3.7-max
QWEN_CHAT_MODEL=qwen3.7-max
QWEN_TRANSLATION_WORKERS=3
QWEN_ANALYSIS_WORKERS=3
QWEN_TRANSLATION_RPM=55
QWEN_MAX_RETRIES=5

# PaddleOCR PP-StructureV3
# Use cpu locally. Change to gpu:0 only after installing a matching
# paddlepaddle-gpu build on the server.
OCR_DEVICE=cpu
PADDLE_PDX_MODEL_SOURCE=BOS

# Automatically translate and deeply analyze each paper after OCR.
AUTO_TRANSLATE=true
AUTO_ANALYZE=true

# Optional override. The default database lives in ./data/paper_reader.db.
# DATABASE_URL=sqlite:///./data/paper_reader.db
