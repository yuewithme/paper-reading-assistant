# Copy this file to .env and fill in your own values.
# Never commit the real .env file.

APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
FRONTEND_ORIGIN=http://localhost:5173

# Qwen / Alibaba Cloud Model Studio
# Beijing OpenAI-compatible endpoint. Replace it if your API key belongs to
# another region or a workspace-specific endpoint.
DASHSCOPE_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_TRANSLATION_MODEL=qwen3.7-plus
QWEN_ANALYSIS_MODEL=qwen3.7-max
QWEN_CHAT_MODEL=qwen3.7-max

# Optional override. The default database lives in ./data/paper_reader.db.
DATABASE_URL=

